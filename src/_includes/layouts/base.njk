<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  {% if noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
  {% if heroPreload %}<link rel="preload" as="image" href="{{ heroPreload }}" type="image/avif" fetchpriority="high">{% endif %}
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-P9KNK007X1"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-P9KNK007X1');
  </script>
  <title>{{ title if title else "Flatirons Creative Studio — Boulder's senior digital marketing agency" }}</title>
  <meta name="description" content="{{ description if description else 'A senior Boulder digital marketing agency: web design, SEO, social campaigns, AI search visibility and AI consulting.' }}">
  <link rel="canonical" href="https://flatironscreativestudio.com{{ page.url }}">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/apple-touch-icon.png">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title if title else 'Flatirons Creative Studio' }}">
  <meta property="og:description" content="{{ description if description else 'A senior Boulder digital marketing agency: web design, SEO, social campaigns, AI search visibility and AI consulting.' }}">
  <meta property="og:url" content="https://flatironscreativestudio.com{{ page.url }}">
  <meta property="og:image" content="https://flatironscreativestudio.com/assets/img/og-image.png">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"></noscript>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": ["LocalBusiness", "ProfessionalService"],
        "@id": "https://flatironscreativestudio.com/#business",
        "name": "Flatirons Creative Studio",
        "url": "https://flatironscreativestudio.com/",
        "logo": "https://flatironscreativestudio.com/assets/img/logo.png",
        "image": "https://flatironscreativestudio.com/assets/img/og-image.png",
        "description": "A senior-led Boulder, Colorado digital marketing agency offering web design, SEO, social media campaigns, AI search visibility and AI productivity consulting.",
        "foundingDate": "2025",
        "email": "hello@flatironscreativestudio.com",
        "telephone": "+1-719-497-1641",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Boulder",
          "addressRegion": "CO",
          "addressCountry": "US"
        },
        "areaServed": [
          { "@type": "City", "name": "Boulder" },
          { "@type": "State", "name": "Colorado" }
        ],
        "founder": {
          "@type": "Person",
          "name": "Trevor Cusworth",
          "sameAs": "https://linkedin.com/in/trevorcusworth"
        }
      },
      {
        "@type": "WebSite",
        "@id": "https://flatironscreativestudio.com/#website",
        "url": "https://flatironscreativestudio.com/",
        "name": "Flatirons Creative Studio",
        "publisher": { "@id": "https://flatironscreativestudio.com/#business" }
      }
    ]
  }
  </script>
  <link rel="stylesheet" href="/assets/css/main.css">
</head>
<body class="{{ 'has-transparent-nav' if page.url == '/' else '' }}">

<nav class="nav" id="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <img src="/assets/img/logo-88.webp" alt="Flatirons Creative Studio" class="nav-logo-img" width="44" height="44" fetchpriority="high" decoding="async">
      <span class="nav-logo-name">Flatirons <em>Creative Studio</em></span>
    </a>
    <div class="nav-links">
      <a href="/services/" {% if page.url == '/services/' %}class="active"{% endif %}>Services</a>
      <a href="/work/"     {% if page.url == '/work/'     %}class="active"{% endif %}>Work</a>
      <a href="/blog/"     {% if page.url == '/blog/'     %}class="active"{% endif %}>Blog</a>
      <a href="/about/"    {% if page.url == '/about/'    %}class="active"{% endif %}>About</a>
      <a href="/contact/"  {% if page.url == '/contact/'  %}class="active"{% endif %}>Contact</a>
      <a href="/book/"     {% if page.url == '/book/'     %}class="active"{% endif %}>Book</a>
      <a href="https://portal.fcstudio.us" target="_blank" rel="noopener">Client Portal ↗</a>
    </div>
    <a href="/contact/" class="nav-cta">Start a Project ↗</a>
    <button class="nav-burger" id="navBurger" aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<div class="mobile-backdrop" id="mobileBackdrop"></div>
<nav class="mobile-sheet" id="mobileSheet">
  <button class="mobile-close" id="mobileClose" aria-label="Close">✕</button>
  <a href="/services/">Services</a>
  <a href="/work/">Work</a>
  <a href="/blog/">Blog</a>
  <a href="/about/">About</a>
  <a href="/contact/">Contact</a>
  <a href="/book/">Book</a>
  <a href="https://portal.fcstudio.us" target="_blank" rel="noopener">Client Portal ↗</a>
  <a href="/contact/" class="mobile-cta">Start a Project ↗</a>
</nav>

{{ content | safe }}

