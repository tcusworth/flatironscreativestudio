---
layout: base.njk
---
<div class="page-header">
  <div class="inner">
    <div class="section-label">{{ eyebrow }}</div>
    <h1 style="font-size:clamp(44px,7vw,96px)">{{ h1 | safe }}</h1>
    <p>{{ lead }}</p>
  </div>
</div>

<section class="section">
  <div class="inner">
    <div class="svc-detail-intro fade-up">
      {% for para in intro %}<p>{{ para | safe }}</p>{% endfor %}
      <span class="pricing-chip">{{ pricing }}</span>
    </div>

    <h2 class="section-h" style="margin:64px 0 28px;font-size:clamp(26px,3vw,40px)">What's <em>included</em></h2>
    <div class="svc-full-grid svc-detail-grid">
      {% for item in includes %}
      <div class="svc-full-card fade-up" style="--accent:#C8961E">
        <h3>{{ item.title }}</h3>
        <p>{{ item.text }}</p>
      </div>
      {% endfor %}
    </div>

    {% if related %}
    <div class="svc-related fade-up">
      <strong>Related:</strong>
      {% for r in related %}<a href="{{ r.url }}">{{ r.label }}</a>{% if not loop.last %} · {% endif %}{% endfor %}
    </div>
    {% endif %}
  </div>
</section>

<div class="cta-band">
  <div class="inner">
    <h2>{{ ctaHeading | safe }}</h2>
    <p>{{ ctaText }}</p>
    <div class="cta-row">
      <a href="#" class="btn btn-amber btn-xl" data-cal>Book a free 30-min call ↗</a>
      <a href="/work/" class="btn btn-ghost-light btn-xl">See our work</a>
    </div>
  </div>
</div>

<script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": serviceName,
      "serviceType": serviceType,
      "description": description,
      "url": "https://flatironscreativestudio.com" + page.url,
      "provider": { "@id": "https://flatironscreativestudio.com/#business" },
      "areaServed": [
        { "@type": "City", "name": "Boulder" },
        { "@type": "State", "name": "Colorado" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://flatironscreativestudio.com/" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://flatironscreativestudio.com/services/" },
        { "@type": "ListItem", "position": 3, "name": serviceName, "item": "https://flatironscreativestudio.com" + page.url }
      ]
    }
  ]
} | dump | safe }}
</script>

<style>
.svc-detail-intro { max-width: 760px; }
.svc-detail-intro p { font-size: 18px; line-height: 1.75; color: #444; margin-bottom: 18px; }
.pricing-chip { display:inline-block; margin-top:8px; padding:8px 18px; border-radius:50px; background:#13120d; color:#c8961e; font-size:12px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }
.svc-detail-grid { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
.svc-related { margin-top: 48px; font-size: 15px; color: #666; }
.svc-related a { color: #c8961e; font-weight: 600; }
@media (max-width: 760px) { .svc-detail-intro p { font-size: 16px; } }
</style>
