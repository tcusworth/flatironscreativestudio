<script>
(function(){
  const form=document.getElementById('clarityCheckForm');
  if(!form) return;
  const submit=document.getElementById('claritySubmit');
  const sent=document.getElementById('claritySent');
  const error=document.getElementById('clarityError');
  form.addEventListener('submit', async function(e){
    e.preventDefault();
    sent.hidden=true;
    error.hidden=true;
    submit.disabled=true;
    const label=submit.querySelector('.btn-label');
    const original=label.textContent;
    label.textContent='Sending…';
    try {
      const response=await fetch(form.action,{
        method:'POST',
        body:new FormData(form),
        headers:{'Accept':'application/json'}
      });
      if(!response.ok) throw new Error('submit failed');
      form.reset();
      sent.hidden=false;
      if(window.gtag) gtag('event','ai_clarity_check_submit',{event_category:'lead'});
    } catch(err) {
      error.hidden=false;
    } finally {
      submit.disabled=false;
      label.textContent=original;
    }
  });
})();
</script>

